# Copy to .env and fill in. The .env file IS auto-loaded (webaggs/config.py)
# the same way as the finance webagg repo; values already set in the shell
# take precedence over this file.
OPENAI_API_KEY=
SERPER_API_KEY=
# Optional: override the single LLM model (one provider, one model - design rule)
WEBAGG_LLM_MODEL=gpt-5-mini
# NOTE: RUN_LIVE and RUN_ONLINE are NEVER read from this file - arming live
# spend or the network preflight is a per-session shell decision:
#   $env:RUN_ONLINE="1"   (preflight)      $env:RUN_LIVE="1"   (live spend)
