# Copy to .env and fill in. Nothing reads this file implicitly — load it into
# the shell / PyCharm run configuration yourself.
OPENAI_API_KEY=
SERPER_API_KEY=
# Optional: override the single LLM model (one provider, one model — design rule)
WEBAGG_LLM_MODEL=gpt-5-mini
# Live-spend gate: experiments refuse to run unless this is exactly 1
RUN_LIVE=0
